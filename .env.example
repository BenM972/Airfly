# ============================================================
# AIRFLY — variables d'environnement
# ============================================================
# Copier ce fichier en `.env.local` pour le developpement, et
# reporter ces memes cles dans le panneau de l'hebergeur pour la
# production. `.env.local` est gitignore : il n'est JAMAIS deploye.
#
# Aucune valeur reelle ici : ce fichier est versionne.
# ============================================================

# --- Domaine canonique -----------------------------------------------------
# Seule variable dont la valeur est publique (prefixe NEXT_PUBLIC_, donc
# incluse dans le bundle navigateur). Elle alimente les canonicals, le
# sitemap, robots.txt et les @id du JSON-LD, et surtout elle ACTIVE la
# redirection www -> apex declaree dans next.config.mjs : sans elle, la
# redirection ne se declenche jamais.
NEXT_PUBLIC_SITE_URL=https://airfly972.com

# --- Supabase --------------------------------------------------------------
# La cle service_role contourne la RLS : strictement cote serveur, jamais
# dans un composant client, jamais dans un depot.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- WooCommerce (catalogue boutique) --------------------------------------
WC_URL=
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# --- WordPress (upload d'images depuis le back office) ---------------------
# Identifiant du mot de passe d'application WordPress. L'ADRESSE est utilisee
# en priorite : le nom d'utilisateur court n'etait pas reconnu et l'envoi de
# photos depuis le back office echouait en 401.
WP_APP_USER_EMAIL=
WP_APP_USER=
WP_APP_PASSWORD=

# --- Back office -----------------------------------------------------------
# ADMIN_PASSWORD : saisi dans le formulaire de connexion.
# ADMIN_SECRET_TOKEN : valeur du cookie de session. Sans ces deux variables,
# la connexion admin renvoie 503 et personne ne peut entrer.
ADMIN_PASSWORD=
ADMIN_SECRET_TOKEN=

# --- Emails de notification (Resend) ---------------------------------------
# L'expediteur est info@airfly972.com par defaut, aucune variable n'est requise.
# airfly972.com et send.airfly972.com sont verifies chez Resend, l'apex ayant
# ete ajoute avec "receiving" DESACTIVE : que des CNAME et un DKIM, aucun MX.
#
# ATTENTION : Resend REFUSE d'envoyer depuis un domaine qu'il n'a pas verifie.
# Tant que ce n'est pas fait, l'envoi echoue en 403 et la demande n'arrive
# nulle part. La verification se fait sur un SOUS-DOMAINE, send.airfly972.com,
# JAMAIS sur l'apex : les enregistrements poses sur l'apex ecraseraient les MX
# de Google Workspace et couperaient la messagerie.
#
# RESEND_FROM ne sert qu'a surcharger, par exemple pour repasser au bac a sable
# le temps d'un test :  RESEND_FROM="AIRFLY <onboarding@resend.dev>"
RESEND_API_KEY=
# RESEND_FROM=
NOTIFY_EMAIL=info@airfly972.com
# Copie(s) CACHEE(S), separees par des virgules. Vider pour desactiver.
# Cachee et non visible : ces notifications portent des donnees personnelles
# de clients, une copie visible exposerait l'adresse de surveillance.
NOTIFY_BCC=contact@bmconsultingfwi.fr

# --- Assistant de chat (Groq) ----------------------------------------------
GROQ_API_KEY=

# --- Google Search Console (statistiques dans le back office) --------------
# Search Console ne peut PAS etre affichee dans un cadre : Google sert ses
# consoles avec X-Frame-Options: DENY. Les donnees sont donc lues par son API
# et mises en forme dans /admin/seo.
#
# Mise en place, dans cet ordre :
#   1. search.google.com/search-console -> ajouter une propriete de type
#      DOMAINE pour airfly972.com, validee par un enregistrement DNS TXT chez
#      Hostinger. Une propriete Domaine couvre l'apex, le www, le http et le
#      https d'un coup ; un prefixe d'URL ne couvre qu'une seule variante.
#   2. console.cloud.google.com -> nouveau projet, activer "Google Search
#      Console API", creer un COMPTE DE SERVICE, telecharger sa cle JSON.
#      Aucun role a lui donner au niveau du projet.
#   3. Search Console -> Parametres -> Utilisateurs et autorisations ->
#      ajouter l'adresse du compte de service en LECTURE SEULE.
#   4. Reporter les trois valeurs ci-dessous.
#
# GSC_SITE_URL doit correspondre EXACTEMENT a la propriete declaree :
#   propriete Domaine        -> sc-domain:airfly972.com
#   propriete Prefixe d'URL  -> https://airfly972.com/   (slash final compris)
GSC_SERVICE_ACCOUNT_EMAIL=
# La cle privee du fichier JSON, champ "private_key". Les sauts de ligne
# peuvent rester ecrits \n : le code les restaure.
GSC_PRIVATE_KEY=
GSC_SITE_URL=sc-domain:airfly972.com

# Jeton de la balise <meta name="google-site-verification">. Inutile avec une
# propriete de type Domaine, qui se valide par DNS. A ne renseigner que si vous
# choisissez une propriete de type prefixe d'URL.
# GOOGLE_SITE_VERIFICATION=
